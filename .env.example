# Server Configuration
PORT=3001
DATABASE_PATH=./data/shoppilot.db

# PayPal Sandbox Integration
# Mode: "mock" (in-memory simulation) or "sandbox" (real PayPal sandbox API)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# LLM Configuration (Gemini / OpenAI compatible)
LLM_API_KEY=

# Grocery Quote Source
# Mode: "mock" (local simulated catalogs) | "channel3" (Channel3 API only) | "hybrid" (Channel3 with mock fallback)
QUOTE_SOURCE=mock
CHANNEL3_API_KEY=
