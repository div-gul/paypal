# Server Configuration
PORT=3001
NODE_ENV=development
DATABASE_PATH=./data/shoppilot.db

# PayPal Sandbox Integration
# Keep mock mode for local-only UI development; use sandbox for real PayPal test orders.
PAYPAL_MODE=mock
ALLOW_LIVE_PAYMENTS=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=INR
# PayPal does not list INR as a supported Orders API currency.
# To charge in USD, set PAYPAL_CURRENCY=USD and provide an explicit conversion rate.
PAYPAL_INR_PER_USD=
APP_BASE_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# LLM Configuration (Google Gemini API: gemini-3.5-flash-lite)
# Leave empty to use local deterministic rule-based parsing and substitution.
LLM_API_KEY=

# Google OAuth 2.0 Integration (Google Identity Services)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email / SMTP Integration (Password Reset & Email Verification)
# Leave empty for local development without outbound emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ShopPilot AI <no-reply@shoppilot.local>"
