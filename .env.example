# Server Configuration
PORT=3001
DATABASE_PATH=./data/shoppilot.db

# PayPal Sandbox Integration
# Mode: "mock" (in-memory simulation) or "sandbox" (real PayPal sandbox API)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_USD_RATE=85
PUBLIC_APP_URL=http://localhost:5173

# LLM Configuration (Gemini / OpenAI compatible)
LLM_API_KEY=
