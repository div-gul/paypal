# Server Configuration
PORT=3001
DATABASE_PATH=./data/shoppilot.db

# PayPal Sandbox Integration
# Keep mock mode for local-only UI development; use sandbox for real PayPal test orders.
PAYPAL_MODE=mock
ALLOW_LIVE_PAYMENTS=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=INR
# PayPal currently does not list INR as an Orders API payment currency.
# To charge an explicitly converted USD amount, set PAYPAL_CURRENCY=USD and provide
# the merchant-approved number of INR per USD. No automatic FX rate is applied.
PAYPAL_INR_PER_USD=
APP_BASE_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# LLM Configuration (Gemini / OpenAI compatible)
LLM_API_KEY=

# Google OAuth 2.0 Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email / SMTP Integration (Password Reset & Email Verification)
# Leave empty for local development without outbound emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ShopPilot AI <no-reply@yourdomain.com>"

