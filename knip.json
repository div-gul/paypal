{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["esbuild"],
  "workspaces": {
    "frontend": {
      "entry": [
        "src/main.tsx",
        "src/index.css",
        "src/tests/**/*.ts",
        "vite.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/components/ApprovalsView.tsx", "src/components/BackendHealthBadge.tsx"],
      "ignoreDependencies": ["sharp"]
    },
    "backend": {
      "entry": [
        "src/index.ts",
        "src/__tests__/**/*.ts",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@types/bcryptjs"]
    }
  }
}
