# Server Configuration
PORT=3001
NODE_ENV=development
DATABASE_PATH=./data/shoppilot.db

# PayPal Sandbox Integration
PAYPAL_MODE=sandbox
ALLOW_LIVE_PAYMENTS=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=INR
# To charge in USD, set PAYPAL_CURRENCY=USD and set an explicit rate:
PAYPAL_INR_PER_USD=
APP_BASE_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# LLM Configuration (Google Gemini API: gemini-3.5-flash-lite)
LLM_API_KEY=

# Google OAuth 2.0 Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email / SMTP Integration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ShopPilot AI <no-reply@shoppilot.local>"
